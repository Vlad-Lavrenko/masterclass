<odoo>

    <record id="td_marketplace_import_wizard_form" model="ir.ui.view">
        <field name="name">td.marketplace.import.wizard.form</field>
        <field name="model">td.marketplace.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Marketplace Data Import Wizard">
                <group>
                    <field name="procedure" invisible="1"/>
                    <field name="procedure_description"/>
                    <field name="marketplace_id" options="{'no_create': True, 'no_edit':True}"/>
                    <field name="page"/>
                    <field name="per_page"/>
                    <field name="site_id"/>
                    <field name="do_update"/>
                </group>
                <footer>
                    <widget name='td_wizard_import_button' button_name="action_import_all"/>
                    <button string="Import" type="object" name="action_import_page" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="td_data_import_wizard_from_marketplace_act_window" model="ir.actions.act_window">
        <field name="name">Marketplace Data Import Wizard</field>
        <field name="res_model">td.marketplace.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="domain">[('marketplace_id','=',active_id)]</field>
        <field name="context">{'default_marketplace_id': active_id}</field>
    </record>
        
</odoo>