<odoo>

    <record id="td_marketplace_order_import_wizard_form" model="ir.ui.view">
        <field name="name">td.marketplace.order.import.wizard.form</field>
        <field name="model">td.marketplace.order.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Marketplace Order Import Wizard">
                <group>
                    <field name="marketplace_id" options="{'no_create': True, 'no_edit':True}"/>
                    <field name="marketpalce_order_sync" readonly='1'/>
                    <field name="last_sync_date" invisible="marketpalce_order_sync=='id'"/>
                    <field name="last_sync_id" invisible="marketpalce_order_sync=='date'"/>
                </group>
                <footer>
                    <!-- <widget name='td_wizard_import_button' button_name="action_import_all"/> -->
                    <button string="Import" type="object" name="action_import_order" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="td_order_import_wizard_from_marketplace_act_window" model="ir.actions.act_window">
        <field name="name">Marketplace Order Import Wizard</field>
        <field name="res_model">td.marketplace.order.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="domain">[('marketplace_id','=',active_id)]</field>
        <field name="context">{'default_marketplace_id': active_id}</field>
    </record>
        
</odoo>