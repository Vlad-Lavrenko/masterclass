<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="td_marketplace_category_view_tree" model="ir.ui.view">
        <field name="name">td.marketplace.category.tree</field>
        <field name="model">td.marketplace.category</field>
        <field name="arch" type="xml">
            <tree>
                <field name="marketplace_id"/>
                <field name="name"/>
                <field name="code"/>
                <field name="parent_id"/>
                <field name="ref"/>
                <field name="full_name"/>
            </tree>
        </field>
    </record>

    <record id="td_marketplace_category_act_window" model="ir.actions.act_window">
        <field name="name">Marketplace category</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">td.marketplace.category</field>
        <field name="view_mode">tree</field>
    </record>

    <menuitem id="td_marketplace_category_menu"
            action="td_marketplace_category_act_window"
            parent="sale.menu_sale_config"
            name="Marketplace category" sequence="300"/>

    <record id="td_marketplace_category_product_wizard_act_window" model="ir.actions.act_window">
        <field name="name">Marketplace Category Product Wizard</field>
        <field name="res_model">td.marketplace.category.product.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>            
</odoo>
