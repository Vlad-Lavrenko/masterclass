<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="td_pricelist_view_tree" model="ir.ui.view">
        <field name="name">td.pricelist.tree</field>
        <field name="model">td.marketplace.pricelist</field>
        <field name="arch" type="xml">
            <tree editable="top">
                <field name="marketplace_id"/>
                <field name="pricelist_id"/>
                <field name="pricelist_type"/>
                <field name="marketplace_code"/>
                <button name="action_upload_pricelist" type="object" string="Upload" class="btn btn-link" icon="fa-refresh" invisible="marketplace_code!=False or pricelist_type!='sale'"/>
            </tree>
        </field>
    </record>

</odoo>